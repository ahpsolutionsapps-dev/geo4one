{
  "name": "geo4one-api",
  "version": "1.0.0",
  "description": "API backend para app_prototipo_admin con arquitectura limpia por features",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:prod",
    "build:dev": "tsc",
    "build:prod": "tsc",
    "start": "npm run start:prod",
    "start:dev": "cross-env NODE_ENV=development node dist/server.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "cross-env NODE_ENV=development prisma migrate dev",
    "prisma:deploy": "cross-env NODE_ENV=production prisma migrate deploy",
    "prisma:deploy:staging": "cross-env NODE_ENV=staging prisma migrate deploy",
    "prisma:studio": "cross-env NODE_ENV=development prisma studio",
    "db:reset": "cross-env NODE_ENV=development prisma migrate reset --force",
    "db:setup:dev": "cross-env NODE_ENV=development tsx scripts/setup-dev-database.ts",
    "db:setup:dev:recreate": "cross-env NODE_ENV=development RECREATE_DEV_DB=1 tsx scripts/setup-dev-database.ts",
    "db:seed:comercial": "cross-env NODE_ENV=development tsx scripts/seed-comercial.ts",
    "db:generate:prod-sql": "tsx scripts/generate-production-sql.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "api",
    "typescript",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pg": "^8.22.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.3",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "prisma": "^7.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  }
}
