{
  "name": "upload-service",
  "version": "1.0.0",
  "description": "Microservicio de gestión de archivos con autenticación por API Key",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:prod",
    "build:dev": "tsc",
    "build:prod": "tsc",
    "start": "npm run start:prod",
    "start:dev": "cross-env NODE_ENV=development node dist/server.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "cross-env NODE_ENV=development prisma migrate dev",
    "prisma:deploy": "cross-env NODE_ENV=production prisma migrate deploy",
    "prisma:deploy:staging": "cross-env NODE_ENV=staging prisma migrate deploy",
    "prisma:studio": "cross-env NODE_ENV=development prisma studio",
    "db:seed": "cross-env NODE_ENV=development tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "upload",
    "files",
    "microservice",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.19.1",
    "prisma": "^6.19.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.3"
  }
}
