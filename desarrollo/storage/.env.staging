PORT=4000
STORAGE_PATH=./storage
MAX_FILE_SIZE=209715200
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,txt,zip,apk
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,application/zip,application/vnd.android.package-archive,application/octet-stream
API_KEY_HEADER=X-API-KEY
PUBLIC_URL=https://ahpsolutions-apps.com/prototipo/upload
ADMIN_TOKEN=REEMPLAZAR_CON_TOKEN_SEGURO_EN_STAGING
JWT_SECRET=REEMPLAZAR_CON_SECRETO_SEGURO_EN_STAGING
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://ahpsolutions-apps.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
ENABLE_DUPLICATE_DETECTION=true
ENABLE_FILE_VALIDATION=true
SIGNED_URL_EXPIRATION_MINUTES=60
ENABLE_COMPRESSION=true
LOG_LEVEL=info
