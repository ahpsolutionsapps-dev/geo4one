  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
  Municipios         Municipios[]
  Proveedores        Proveedores[]
}

model SectoresBarrios {
  IdSectorBarrio     BigInt        @id @default(autoincrement())
  IdMunicipio        BigInt
  SectorBarrio       String        @db.VarChar(150)
  Circunscripcion    String?       @db.VarChar(50)
  Latitud            Decimal?      @db.Decimal(10, 7)
  Longitud           Decimal?      @db.Decimal(10, 7)
  Activo             Boolean       @default(true)
  FechaCreacion      DateTime      @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime      @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
  Proveedores        Proveedores[]
  Municipios         Municipios    @relation(fields: [IdMunicipio], references: [IdMunicipio], onDelete: NoAction, onUpdate: NoAction, map: "FK_SectoresBarrios_Municipios")

  @@unique([IdMunicipio, SectorBarrio], map: "UQ_SectoresBarrios_Municipio_Sector")
  @@index([IdMunicipio], map: "IX_SectoresBarrios_IdMunicipio")
}

model Tamanos {
  IdTamano           BigInt      @id @default(autoincrement())
  Tamano             String      @unique(map: "UQ_Tamanos_Tamano") @db.VarChar(100)
  Activo             Boolean     @default(true)
  FechaCreacion      DateTime    @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime    @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
}

model TiposElementos {
  IdTipoElemento     BigInt      @id @default(autoincrement())
  TipoElemento       String      @unique(map: "UQ_TiposElementos_TipoElemento") @db.VarChar(150)
  Activo             Boolean     @default(true)
  FechaCreacion      DateTime    @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime    @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
  Formatos           Formatos[]
}

model Anunciantes {
  IdAnunciante            BigInt                  @id @default(autoincrement())
  IdSectorIndustrial      BigInt
  IdSubSectorIndustrial   BigInt
  IdCategoriaAnunciante   BigInt
  Anunciante              String                  @db.VarChar(200)
  Activo                  Boolean                 @default(true)
  FechaCreacion           DateTime                @default(now()) @db.Timestamptz(6)
  FechaActualizacion      DateTime                @default(now()) @db.Timestamptz(6)
  CreadoPor               BigInt?
  ActualizadoPor          BigInt?
  CategoriasAnunciantes   CategoriasAnunciantes   @relation(fields: [IdCategoriaAnunciante], references: [IdCategoriaAnunciante], onDelete: NoAction, onUpdate: NoAction, map: "FK_Anunciantes_CategoriasAnunciantes")
  SectoresIndustriales    SectoresIndustriales    @relation(fields: [IdSectorIndustrial], references: [IdSectorIndustrial], onDelete: NoAction, onUpdate: NoAction, map: "FK_Anunciantes_SectoresIndustriales")
  SubSectoresIndustriales SubSectoresIndustriales @relation(fields: [IdSubSectorIndustrial], references: [IdSubSectorIndustrial], onDelete: NoAction, onUpdate: NoAction, map: "FK_Anunciantes_SubSectoresIndustriales")
  MarcasProductos         MarcasProductos[]
  VersionesCampanas       VersionesCampanas[]

  @@unique([IdCategoriaAnunciante, Anunciante], map: "UQ_Anunciantes_Categoria_Anunciante")
  @@index([Anunciante], map: "IX_Anunciantes_Anunciante")
  @@index([IdCategoriaAnunciante], map: "IX_Anunciantes_IdCategoriaAnunciante")
  @@index([IdSectorIndustrial], map: "IX_Anunciantes_IdSectorIndustrial")
  @@index([IdSubSectorIndustrial], map: "IX_Anunciantes_IdSubSectorIndustrial")
}

model CategoriasAnunciantes {
  IdCategoriaAnunciante   BigInt                  @id @default(autoincrement())
  IdSectorIndustrial      BigInt
  IdSubSectorIndustrial   BigInt
  CategoriaAnunciante     String                  @db.VarChar(150)
  Activo                  Boolean                 @default(true)
  FechaCreacion           DateTime                @default(now()) @db.Timestamptz(6)
  FechaActualizacion      DateTime                @default(now()) @db.Timestamptz(6)
  CreadoPor               BigInt?
  ActualizadoPor          BigInt?
