generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Modulo {
  idModulo     Int         @id @default(autoincrement()) @map("IdModulo")
  nombreModulo String      @map("NombreModulo")
  icono        String?     @map("Icono")
  ruta         String?     @map("Ruta")
  idPadre      Int?        @map("IdPadre")
  orderIndex   Int?        @default(0) @map("OrderIndex")
  codigo       String?     @map("Codigo")
  oculto       Boolean     @default(false) @map("Oculto")
  padre        Modulo?     @relation("ModuloPadre", fields: [idPadre], references: [idModulo], onUpdate: NoAction)
  hijos        Modulo[]    @relation("ModuloPadre")
  rolModulos   RolModulo[]

  @@map("Modulos")
}

model Negocio {
  idNegocio                                     Int       @id @default(autoincrement()) @map("IdNegocio")
  nombre                                        String    @map("Nombre") @db.VarChar(150)
  rnc                                           String?   @map("RNC") @db.VarChar(20)
  direccion                                     String?   @map("Direccion")
  telefono                                      String?   @map("Telefono") @db.VarChar(30)
  email                                         String?   @map("Email") @db.VarChar(150)
  fechaCreacion                                 DateTime  @default(now()) @map("FechaCreacion")
  fechaModificacion                             DateTime? @map("FechaModificacion")
  fechaAnulacion                                DateTime? @map("FechaAnulacion")
  anulado                                       Boolean   @default(false) @map("Anulado")
  comentarioAnulado                             String?   @map("ComentarioAnulado")
  idUsuarioRegistra                             Int       @map("IdUsuarioRegistra")
  idUsuarioModifica                             Int?      @map("IdUsuarioModifica")
  idUsuarioAnula                                Int?      @map("IdUsuarioAnula")
  Usuarios_Negocios_IdUsuarioAnulaToUsuarios    Usuario?  @relation("Negocios_IdUsuarioAnulaToUsuarios", fields: [idUsuarioAnula], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Negocios_Anula")
  Usuarios_Negocios_IdUsuarioModificaToUsuarios Usuario?  @relation("Negocios_IdUsuarioModificaToUsuarios", fields: [idUsuarioModifica], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Negocios_Modifica")
  Usuarios_Negocios_IdUsuarioRegistraToUsuarios Usuario   @relation("Negocios_IdUsuarioRegistraToUsuarios", fields: [idUsuarioRegistra], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Negocios_Registra")
  roles                                         Rol[]
  usuarios                                      Usuario[]

  @@map("Negocios")
}

model Rol {
  idRol             Int         @id @default(autoincrement()) @map("IdRol")
  rol               String      @map("Rol") @db.VarChar(100)
  descripcion       String      @map("Descripcion")
  idUsuarioRegistra Int?        @map("IdUsuarioRegistra")
  fechaCreacion     DateTime    @default(now()) @map("FechaCreacion") @db.Timestamp(6)
  idUsuarioModifica Int?        @map("IdUsuarioModifica")
  fechaModificacion DateTime?   @map("FechaModificacion") @db.Timestamp(6)
  anulado           Boolean     @default(false) @map("Anulado")
  idUsuarioAnula    Int?        @map("IdUsuarioAnula")
  fechaAnulado      DateTime?   @map("FechaAnulado") @db.Timestamp(6)
  comentario        String?     @map("Comentario")
  idNegocio         Int         @map("IdNegocio")
  rolModulos        RolModulo[]
  usuarioAnula      Usuario?    @relation("RolAnula", fields: [idUsuarioAnula], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Roles_Anula")
  usuarioModifica   Usuario?    @relation("RolModifica", fields: [idUsuarioModifica], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Roles_Modifica")
  negocio           Negocio     @relation(fields: [idNegocio], references: [idNegocio], map: "FK_Roles_Negocios")
  usuarioRegistra   Usuario?    @relation("RolRegistra", fields: [idUsuarioRegistra], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Roles_Registra")
  usuarios          Usuario[]   @relation("UsuarioRol")

  @@map("Roles")
}

model Usuario {
  idUsuario                                     Int              @id @default(autoincrement()) @map("IdUsuario")
  idRol                                         Int?             @map("IdRol")
  username                                      String           @unique @map("Username") @db.VarChar(100)
  email                                         String           @map("Email") @db.VarChar(150)
  passwordHash                                  String           @map("Userpassword")
  nombre                                        String           @map("Nombre") @db.VarChar(100)
  apellido                                      String?          @map("Apellido") @db.VarChar(100)
  telefono                                      String?          @map("Telefono") @db.VarChar(30)
  palabraSecreta                                String?          @map("PalabraSecreta") @db.VarChar(255)
  habilitado                                    Boolean          @default(true) @map("Habilitado")
  verificado                                    Boolean          @default(false) @map("Verificado")
  estatus                                       Int              @default(1) @map("Estatus") @db.SmallInt
  imagen                                        String?          @map("Imagen")
  primaryColor                                  String?          @map("PrimaryColor") @db.VarChar(30)
  idioma                                        String           @default("es") @map("Idioma") @db.VarChar(10)
  tema                                          String           @default("sistema") @map("Tema") @db.VarChar(20)
  intentosFallidos                              Int              @default(0) @map("IntentosFallidos") @db.SmallInt
  ultimoAcceso                                  DateTime?        @map("UltimoAcceso") @db.Timestamp(6)
  bloqueadoHasta                                DateTime?        @map("BloqueadoHasta") @db.Timestamp(6)
  idUsuarioRegistra                             Int?             @map("IdUsuarioRegistra")
  fechaCreacion                                 DateTime         @default(now()) @map("FechaCreacion") @db.Timestamp(6)
  idUsuarioModifica                             Int?             @map("IdUsuarioModifica")
  fechaModificacion                             DateTime?        @map("FechaModificacion") @db.Timestamp(6)
  anulado                                       Boolean          @default(false) @map("Anulado")
  idUsuarioAnula                                Int?             @map("IdUsuarioAnula")
  fechaAnulado                                  DateTime?        @map("FechaAnulado") @db.Timestamp(6)
  comentario                                    String?          @map("Comentario")
  darkColorScheme                               String?          @default("cinder") @map("DarkColorScheme") @db.VarChar(20)
  idNegocio                                     Int              @map("IdNegocio")
  Negocios_Negocios_IdUsuarioAnulaToUsuarios    Negocio[]        @relation("Negocios_IdUsuarioAnulaToUsuarios")
  Negocios_Negocios_IdUsuarioModificaToUsuarios Negocio[]        @relation("Negocios_IdUsuarioModificaToUsuarios")
  Negocios_Negocios_IdUsuarioRegistraToUsuarios Negocio[]        @relation("Negocios_IdUsuarioRegistraToUsuarios")
  qrLoginSessions                               QrLoginSession[]
  rolesAnula                                    Rol[]            @relation("RolAnula")
  rolesModifica                                 Rol[]            @relation("RolModifica")
  rolesRegistra                                 Rol[]            @relation("RolRegistra")
  usuarioAnula                                  Usuario?         @relation("UsuarioAnula", fields: [idUsuarioAnula], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Usuarios_Anula")
  anulados                                      Usuario[]        @relation("UsuarioAnula")
  usuarioModifica                               Usuario?         @relation("UsuarioModifica", fields: [idUsuarioModifica], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Usuarios_Modifica")
  modificados                                   Usuario[]        @relation("UsuarioModifica")
  negocio                                       Negocio          @relation(fields: [idNegocio], references: [idNegocio], map: "FK_Usuarios_Negocios")
  usuarioRegistra                               Usuario?         @relation("UsuarioRegistra", fields: [idUsuarioRegistra], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_Usuarios_Registra")
  registrados                                   Usuario[]        @relation("UsuarioRegistra")
  rol                                           Rol?             @relation("UsuarioRol", fields: [idRol], references: [idRol], map: "FK_Usuarios_Roles")

  @@map("Usuarios")
}

model RolModulo {
  idRolModulo Int    @id @default(autoincrement()) @map("IdRolModulo")
  idRol       Int    @map("IdRol")
  idModulo    Int    @map("IdModulo")
  modulo      Modulo @relation(fields: [idModulo], references: [idModulo], onDelete: Cascade, map: "FK_RolModulos_Modulos")
  rol         Rol    @relation(fields: [idRol], references: [idRol], onDelete: Cascade, map: "FK_RolModulos_Roles")

  @@map("RolModulos")
}

model QrLoginSession {
  idQrLoginSession Int       @id @default(autoincrement()) @map("IdQrLoginSession")
  code             String    @map("Code")
  status           String    @default("pending") @map("Status")
  idUsuario        Int?      @map("IdUsuario")
  token            String?   @map("Token")
  deviceName       String?   @map("DeviceName")
  expiraEn         DateTime  @map("ExpiraEn") @db.Timestamp(6)
  aprobadoEn       DateTime? @map("AprobadoEn") @db.Timestamp(6)
  consumidoEn      DateTime? @map("ConsumidoEn") @db.Timestamp(6)
  creadoEn         DateTime  @default(now()) @map("CreadoEn") @db.Timestamp(6)
  usuario          Usuario?  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade, onUpdate: NoAction)

  @@map("QrLoginSessions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Auditoria {
  IdAuditoria     BigInt   @id @default(autoincrement())
  Tabla           String   @db.VarChar(150)
  IdRegistro      BigInt?
  Accion          String   @db.VarChar(10)
  IdUsuario       BigInt?
  DatosAnteriores Json?
  DatosNuevos     Json?
  DireccionIP     String?  @db.Inet
  UserAgent       String?
  Fecha           DateTime @default(now()) @db.Timestamptz(6)

  @@index([Accion], map: "IX_Auditoria_Accion")
  @@index([Fecha], map: "IX_Auditoria_Fecha")
  @@index([IdUsuario], map: "IX_Auditoria_IdUsuario")
  @@index([Tabla, IdRegistro], map: "IX_Auditoria_Tabla_IdRegistro")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Elementos {
  IdElemento         BigInt           @id @default(autoincrement())
  IdProveedor        BigInt
  Licencia           String?          @db.VarChar(100)
  FechaEmision       DateTime?        @db.Date
  FechaVencimiento   DateTime?        @db.Date
  IdSeguimiento      String?          @db.VarChar(100)
  IdTipoElemento     BigInt
  IdFormato          BigInt?
  IdTamano           BigInt?
  Activo             Boolean          @default(true)
  CostoAlquiler      Decimal?         @db.Decimal(14, 2)
  Direccion          String?          @db.VarChar(500)
  IdOrientacion      BigInt?
  IdProvincia        BigInt?
  IdMunicipio        BigInt?
  IdSectorBarrio     BigInt?
  Circunscripcion    String?          @db.VarChar(50)
  Latitud            Decimal?         @db.Decimal(10, 7)
  Longitud           Decimal?         @db.Decimal(10, 7)
  Anulado            Boolean          @default(false)
  AnuladoPor         BigInt?
  ComentarioAnulado  String?          @db.VarChar(500)
  FechaAnulacion     DateTime?        @db.Timestamptz(6)
  FechaCreacion      DateTime         @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime         @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Colocaciones       Colocaciones[]
  Formatos           Formatos?        @relation(fields: [IdFormato], references: [IdFormato], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_Formatos")
  Municipios         Municipios?      @relation(fields: [IdMunicipio], references: [IdMunicipio], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_Municipios")
  Orientaciones      Orientaciones?   @relation(fields: [IdOrientacion], references: [IdOrientacion], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_Orientaciones")
  Proveedores        Proveedores      @relation(fields: [IdProveedor], references: [IdProveedor], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_Proveedores")
  Provincias         Provincias?      @relation(fields: [IdProvincia], references: [IdProvincia], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_Provincias")
  SectoresBarrios    SectoresBarrios? @relation(fields: [IdSectorBarrio], references: [IdSectorBarrio], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_SectoresBarrios")
  Tamanos            Tamanos?         @relation(fields: [IdTamano], references: [IdTamano], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_Tamanos")
  TiposElementos     TiposElementos   @relation(fields: [IdTipoElemento], references: [IdTipoElemento], onDelete: NoAction, onUpdate: NoAction, map: "FK_Elementos_TiposElementos")

  @@index([Activo], map: "IX_Elementos_Activo")
  @@index([Anulado], map: "IX_Elementos_Anulado")
  @@index([IdFormato], map: "IX_Elementos_IdFormato")
  @@index([IdMunicipio], map: "IX_Elementos_IdMunicipio")
  @@index([IdOrientacion], map: "IX_Elementos_IdOrientacion")
  @@index([IdProveedor], map: "IX_Elementos_IdProveedor")
  @@index([IdProvincia], map: "IX_Elementos_IdProvincia")
  @@index([IdSectorBarrio], map: "IX_Elementos_IdSectorBarrio")
  @@index([IdSeguimiento], map: "IX_Elementos_IdSeguimiento")
  @@index([IdTamano], map: "IX_Elementos_IdTamano")
  @@index([IdTipoElemento], map: "IX_Elementos_IdTipoElemento")
  @@index([Licencia], map: "IX_Elementos_Licencia")
}

model Formatos {
  IdFormato          BigInt         @id @default(autoincrement())
  IdTipoElemento     BigInt
  Formato            String         @db.VarChar(150)
  IconoMapa          String?        @db.VarChar(500)
  Activo             Boolean        @default(true)
  FechaCreacion      DateTime       @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime       @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
  TiposElementos     TiposElementos @relation(fields: [IdTipoElemento], references: [IdTipoElemento], onDelete: NoAction, onUpdate: NoAction, map: "FK_Formatos_TiposElementos")

  @@unique([IdTipoElemento, Formato], map: "UQ_Formatos_TipoElemento_Formato")
  @@index([IdTipoElemento], map: "IX_Formatos_IdTipoElemento")
}

model Municipios {
  IdMunicipio        BigInt            @id @default(autoincrement())
  IdProvincia        BigInt
  Municipio          String            @db.VarChar(100)
  Latitud            Decimal?          @db.Decimal(10, 7)
  Longitud           Decimal?          @db.Decimal(10, 7)
  Activo             Boolean           @default(true)
  FechaCreacion      DateTime          @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime          @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
  Provincias         Provincias        @relation(fields: [IdProvincia], references: [IdProvincia], onDelete: NoAction, onUpdate: NoAction, map: "FK_Municipios_Provincias")
  Proveedores        Proveedores[]
  SectoresBarrios    SectoresBarrios[]

  @@unique([IdProvincia, Municipio], map: "UQ_Municipios_Provincia_Municipio")
  @@index([IdProvincia], map: "IX_Municipios_IdProvincia")
}

model Orientaciones {
  IdOrientacion      BigInt      @id @default(autoincrement())
  Orientacion        String      @unique(map: "UQ_Orientaciones_Orientacion") @db.VarChar(100)
  Activo             Boolean     @default(true)
  FechaCreacion      DateTime    @default(now()) @db.Timestamptz(6)
  FechaActualizacion DateTime    @default(now()) @db.Timestamptz(6)
  CreadoPor          BigInt?
  ActualizadoPor     BigInt?
  Elementos          Elementos[]
}

model Proveedores {
  IdProveedor          BigInt                 @id @default(autoincrement())
  Proveedor            String                 @db.VarChar(200)
  RNC                  String?                @unique(map: "UQ_Proveedores_RNC") @db.VarChar(20)
  PersonaContacto      String?                @db.VarChar(150)
  Cargo                String?                @db.VarChar(100)
  Email                String?                @db.VarChar(150)
  PaginaWeb            String?                @db.VarChar(255)
  Direccion            String?                @db.VarChar(500)
  IdProvincia          BigInt?
  IdMunicipio          BigInt?
  IdSectorBarrio       BigInt?
  Activo               Boolean                @default(true)
  FechaCreacion        DateTime               @default(now()) @db.Timestamptz(6)
  FechaActualizacion   DateTime               @default(now()) @db.Timestamptz(6)
  CreadoPor            BigInt?
  ActualizadoPor       BigInt?
  Elementos            Elementos[]
  Municipios           Municipios?            @relation(fields: [IdMunicipio], references: [IdMunicipio], onDelete: NoAction, onUpdate: NoAction, map: "FK_Proveedores_Municipios")
  Provincias           Provincias?            @relation(fields: [IdProvincia], references: [IdProvincia], onDelete: NoAction, onUpdate: NoAction, map: "FK_Proveedores_Provincias")
  SectoresBarrios      SectoresBarrios?       @relation(fields: [IdSectorBarrio], references: [IdSectorBarrio], onDelete: NoAction, onUpdate: NoAction, map: "FK_Proveedores_SectoresBarrios")
  ProveedoresTelefonos ProveedoresTelefonos[]

  @@index([IdMunicipio], map: "IX_Proveedores_IdMunicipio")
  @@index([IdProvincia], map: "IX_Proveedores_IdProvincia")
  @@index([IdSectorBarrio], map: "IX_Proveedores_IdSectorBarrio")
  @@index([Proveedor], map: "IX_Proveedores_Proveedor")
}

model ProveedoresTelefonos {
  IdProveedorTelefono BigInt      @id @default(autoincrement())
  IdProveedor         BigInt
  Telefono            String      @db.VarChar(30)
  Tipo                String?     @db.VarChar(30)
  Principal           Boolean     @default(false)
  Activo              Boolean     @default(true)
  FechaCreacion       DateTime    @default(now()) @db.Timestamptz(6)
  FechaActualizacion  DateTime    @default(now()) @db.Timestamptz(6)
  CreadoPor           BigInt?
  ActualizadoPor      BigInt?
  Proveedores         Proveedores @relation(fields: [IdProveedor], references: [IdProveedor], onDelete: Cascade, onUpdate: NoAction, map: "FK_ProveedoresTelefonos_Proveedores")

  @@index([IdProveedor], map: "IX_ProveedoresTelefonos_IdProveedor")
}

model Provincias {
  IdProvincia        BigInt        @id @default(autoincrement())
  Provincia          String        @unique(map: "UQ_Provincias_Provincia") @db.VarChar(100)
  Latitud            Decimal?      @db.Decimal(10, 7)
  Longitud           Decimal?      @db.Decimal(10, 7)
  Activo             Boolean       @default(true)
